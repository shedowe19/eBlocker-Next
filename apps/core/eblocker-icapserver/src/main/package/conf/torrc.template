# Required external control-auth configuration; absence fails closed.
# Provision a loopback ControlPort and per-installation HashedControlPassword there.
# Never enable an unauthenticated control listener.
%include /etc/tor/eblocker-control-auth.conf
TransPort 0.0.0.0:12346
TransPort [::]:12346

# Number of seconds Tor waits for a circuit before it closes the socks connection
# (which leads to the ERR_ZERO_SIZE_OBJECT error in Squid):
SocksTimeout 30

#control specific Exit nodes (countries)
@SET_EXIT_NODES@ ExitNodes @EXIT_NODES@
@SET_EXIT_NODES@ StrictNodes 1

DNSPort 0.0.0.0:9053
DNSPort [::]:9053
