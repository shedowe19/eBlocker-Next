<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
  <!-- Google documents this HTTPS mirror at https://docs.cloud.google.com/docs/buildpacks/java .
       Mirror only Central; the project's separate eBlocker repositories remain unchanged. -->
  <mirrors>
    <mirror>
      <id>google-maven-central</id>
      <name>Google Cloud Storage mirror of Maven Central</name>
      <url>https://maven-central.storage-download.googleapis.com/maven2/</url>
      <mirrorOf>central</mirrorOf>
    </mirror>
  </mirrors>
  <servers>
    <server>
      <id>google-maven-central</id>
      <configuration>
        <!-- Wagon (Bookworm Maven 3.8); native Resolver also accepts the all block. -->
        <httpConfiguration>
          <all>
            <connectionTimeout>30000</connectionTimeout>
            <readTimeout>120000</readTimeout>
          </all>
        </httpConfiguration>
      </configuration>
    </server>
  </servers>
</settings>
